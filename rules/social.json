[
  {
    "id": "social.twitter",
    "name": "Twitter / X tracking",
    "description": "Share-sheet and referrer params on twitter.com and x.com.",
    "matcher": { "type": "host", "suffix": ["twitter.com", "x.com"] },
    "actions": [
      { "type": "removeParameters", "select": { "names": ["s", "t", "ref_src", "ref_url", "src"] } }
    ],
    "source": "builtIn",
    "category": "social"
  },
  {
    "id": "social.instagram",
    "name": "Instagram tracking",
    "description": "Share grid id appended to shared Instagram links.",
    "matcher": { "type": "host", "suffix": ["instagram.com"] },
    "actions": [
      { "type": "removeParameters", "select": { "names": ["igshid", "igsh"] } }
    ],
    "source": "builtIn",
    "category": "social"
  },
  {
    "id": "social.facebook",
    "name": "Facebook tracking",
    "description": "Action/referrer/notification tracking on Facebook hosts. fbclid handled globally.",
    "matcher": { "type": "host", "suffix": ["facebook.com", "fb.com"] },
    "actions": [
      {
        "type": "removeParameters",
        "select": {
          "names": ["fb_action_ids", "fb_action_types", "fb_source", "fb_ref",
                    "comment_tracking", "notif_t", "notif_id", "ref", "refsrc", "hrc"]
        }
      }
    ],
    "source": "builtIn",
    "category": "social"
  },
  {
    "id": "social.tiktok",
    "name": "TikTok tracking",
    "description": "Webapp/copy-link tracking params on TikTok.",
    "matcher": { "type": "host", "suffix": ["tiktok.com"] },
    "actions": [
      { "type": "removeParameters", "select": { "names": ["is_copy_url", "is_from_webapp", "_r", "_t"] } }
    ],
    "source": "builtIn",
    "category": "social"
  },
  {
    "id": "social.youtube",
    "name": "YouTube cleanup",
    "description": "Keep only the params that affect playback; strip everything else (feature, si, pp, etc.).",
    "matcher": { "type": "host", "suffix": ["youtube.com", "youtu.be"] },
    "actions": [
      { "type": "removeParameters", "select": { "keepOnly": ["v", "t", "list", "index"] } }
    ],
    "source": "builtIn",
    "category": "social"
  }
]

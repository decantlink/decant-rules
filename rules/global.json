            "mc_eid", "mc_cid", "mkt_tok", "_hsenc", "_hsmi", "vero_id", "oly_enc_id", "oly_anon_id"
          ]
        }
      }
    ],
    "source": "builtIn",
    "category": "tracking"
  }
]
